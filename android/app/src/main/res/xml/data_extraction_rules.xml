<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to cloud backup; a phone-to-phone transfer takes the settings but never the API key
     (its Keystore key can't leave this phone anyway, so a copied ciphertext would be useless). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
